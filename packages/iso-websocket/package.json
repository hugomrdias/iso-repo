{
  "name": "iso-websocket",
  "type": "module",
  "version": "0.5.1",
  "description": "Isomorphic, resilient and extensible Websocket.",
  "author": "Hugo Dias <hugomrdias@gmail.com> (hugodias.me)",
  "license": "MIT",
  "homepage": "https://github.com/hugomrdias/iso-repo/tree/master/packages/iso-websocket",
  "repository": {
    "url": "hugomrdias/iso-repo",
    "directory": "packages/iso-websocket"
  },
  "bugs": {
    "url": "https://github.com/hugomrdias/iso-repo/issues"
  },
  "keywords": [
    "websocket",
    "reconnect",
    "retry",
    "websocket-client"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "main": "src/index.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "src",
    "dist/src/*.d.ts",
    "dist/src/*.d.ts.map"
  ],
  "scripts": {
    "lint": "tsc --build && biome check --no-errors-on-unmatched --files-ignore-unknown=true .",
    "test": "tsc --build && pnpm run test:node && pnpm run test:browser",
    "test:node": "playwright-test 'test/**/!(*.browser).test.js' --mode node",
    "test:browser": "playwright-test 'test/**/!(*.node).test.js' --assets test/mocks"
  },
  "dependencies": {
    "debug": "^4.4.3",
    "retry": "^0.13.1",
    "typescript-event-target": "^1.1.2"
  },
  "devDependencies": {
    "@types/debug": "catalog:",
    "@types/node": "catalog:",
    "@types/retry": "^0.12.5",
    "@types/ws": "^8.18.1",
    "delay": "catalog:",
    "p-defer": "^4.0.1",
    "playwright-test": "catalog:",
    "type-fest": "catalog:",
    "typescript": "catalog:",
    "ws": "^8.21.3"
  },
  "publishConfig": {
    "provenance": true
  },
  "depcheck": {
    "specials": [
      "bin"
    ],
    "ignores": [
      "@types/*",
      "assert",
      "type-fest"
    ]
  }
}
